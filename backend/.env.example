# Copie este archivo como .env y ajuste los valores. El .env nunca se sube al repositorio.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://sgl:sgl@localhost:5432/sgl

# Base de datos usada por las pruebas automáticas (npm test)
DATABASE_URL_TEST=postgres://sgl:sgl@localhost:5432/sgl_test

# Origen permitido por CORS (frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Secreto para firmar los JWT (mínimo 32 caracteres; use uno aleatorio)
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio

# Duración de la sesión en segundos; se renueva mientras el usuario tenga actividad
JWT_EXPIRA_EN=1800

# Costo de bcrypt (10 a 14 es razonable)
BCRYPT_COSTO=12
